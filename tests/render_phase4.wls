dirs = Select[FileNames[FileNameJoin[{$TemporaryDirectory, "reduced-sphere-fast-*"}]], DirectoryQ]; If[dirs === {}, Exit[2]];
dir = Last@SortBy[dirs, FileDate]; out = FileNameJoin[{dir, "renders"}]; If[!DirectoryQ[out], CreateDirectory[out]];
files = Table[SelectFirst[FileNames["sampled_reduced_sphere_stage=" <> ToString[stage] <> "_dir=" <> ToString[stage-1] <> "*.vtk", dir], FileExistsQ, Missing["NotFound"]], {stage, 1, 3}]; If[AnyTrue[files, MissingQ], Exit[3]];
render[file_, stage_] := Module[{g = Import[file], global, seam}, global = Show[g, BoxRatios -> {1, 1, 1}, Boxed -> False, Axes -> False, PlotRange -> All, ViewPoint -> {2.1, -2.5, 1.6}, ImageSize -> 650]; seam = Show[g, BoxRatios -> {1, 1, 1}, Boxed -> False, Axes -> False, PlotRange -> {{-.18, .18}, {-.18, .18}, {.04, .14}}, ViewPoint -> {2.1, -2.5, 1.6}, ImageSize -> 650]; Export[FileNameJoin[{out, "stage" <> ToString[stage] <> "-global.png"}], global]; Export[FileNameJoin[{out, "stage" <> ToString[stage] <> "-seam.png"}], seam]];
MapIndexed[render[#1, First@#2] &, files]; pngs = FileNames["*.png", out]; If[Length[pngs] != 6 || !AllTrue[pngs, FileByteCount[#] > 10000 &], Exit[4]]; Print["phase4_render=pass directory=" <> out <> " png=6 imported_surfaces=3"];
